PORT=
NODE_ENV=

# Database (must match docker-compose.yml when using local Postgres)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
POSTGRES_URI=
# Prisma CLI also reads DATABASE_URL (keep in sync with POSTGRES_URI).
DATABASE_URL=
# Optional: separate DB for `prisma migrate dev` shadow replay (must differ from POSTGRES_URI).
# Example local Docker: postgresql://qabasone-api:password@localhost:5432/qabasone_shadow
SHADOW_DATABASE_URL=

# Seed (optional)
SEED_DEFAULT_PASSWORD=
SEED_ADMIN_PASSWORD=

# Development-only operational data reset (`npm run db:reset-operational:dev`)
# DEV_OPERATIONAL_RESET_ENABLED=true
# DEV_RESET_SUPERADMIN_USERNAME=mahros
# DEV_RESET_SUPERADMIN_PASSWORD=

# E2E (optional — requires `npm run seed:full` against target DB)
# E2E_ADMIN_USERNAME=admin
# E2E_ADMIN_PASSWORD=
# E2E_DRIVER_USERNAME=ahmed
# E2E_DRIVER_PASSWORD=password
# E2E_ACCOUNTANT_USERNAME=accountant
# E2E_ACCOUNTANT_PASSWORD=password
# E2E_BOOTSTRAP_ADMIN_USERNAME=mahros
# E2E_BOOTSTRAP_ADMIN_PASSWORD=password
# RUN_E2E_SCENARIOS=1
# RUN_E2E_FULL_MATRIX=1

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=
AUTH_ACCESS_TOKEN_EXPIRES_IN=
AUTH_REFRESH_TOKEN_EXPIRES_IN=

# ---------------------------------------------------------------------------
# Redis — required for production multi-replica behavior
# ---------------------------------------------------------------------------
# Used for: WebAuthn challenges, shared rate limits, permission cache,
# audit pub/sub, and posting-worker leader election.
#
# Production (managed Redis with TLS):
#   REDIS_URL=rediss://your-cluster.example.com:6379
#   REDIS_PASSWORD=<from secrets manager>
#
# Local docker-compose (no auth — NODE_ENV must not be production):
#   docker compose up -d redis
#   REDIS_URL=redis://localhost:6379
#
# If REDIS_URL is unset in production: posting worker runs in single-replica
# mode (no leader election). Safe only with one API replica — set REDIS_URL
# for multi-replica deploys. WebAuthn and shared rate limits still need Redis.
# See docs/PRODUCTION_ENV.md
REDIS_URL=
# Required when REDIS_URL is set and NODE_ENV=production (fail-fast at boot).
REDIS_PASSWORD=
# Boot wait for Redis before posting worker / pub-sub bridges (ms). Helps when
# Redis is on an external Docker network without depends_on. Defaults: 60000 / 2000.
# REDIS_STARTUP_WAIT_MS=60000
# REDIS_STARTUP_RETRY_MS=2000
# Docker/K8s readiness: probe GET /ready (not /health) when REDIS_URL is set.
# Host port for docker-compose redis service only (not read by app config).
REDIS_PORT=

# ---------------------------------------------------------------------------
# Driver-day async posting worker (runs inside HTTP server process via npm run dev / start)
# ---------------------------------------------------------------------------
# Production: requires REDIS_URL for leader election across replicas.
# Development: worker runs in single-instance mode (no leader election) even if
# REDIS_URL is set — start Redis only when testing passkeys, rate limits, etc.
# E2E tests drive jobs explicitly; worker is not relied on in CI.
#
# Production recommended (defaults shown — omit to use defaults):
#   POSTING_WORKER_ENABLED=true
#   POSTING_WORKER_POLL_INTERVAL_MS=2000
#   POSTING_WORKER_BATCH_SIZE=2
#   POSTING_WORKER_LEADER_LEASE_SEC=15
#   POSTING_WORKER_STALE_PROCESSING_SEC=120
#   POSTING_WORKER_LEADER_KEY=alqabasy-com:posting-worker:leader
# Optional — tenant-scoped Redis leader lock when multiple deployments share REDIS_URL.
# If unset, derived from WEBAUTHN_RP_ID or database name (see docs/PRODUCTION_ENV.md).
POSTING_WORKER_ENABLED=
POSTING_WORKER_POLL_INTERVAL_MS=
POSTING_WORKER_BATCH_SIZE=
POSTING_WORKER_LEADER_LEASE_SEC=
POSTING_WORKER_STALE_PROCESSING_SEC=
POSTING_WORKER_LEADER_KEY=

# ---------------------------------------------------------------------------
# Official printables PDF renderer
# ---------------------------------------------------------------------------
# Required for PDF print jobs. Without this, jobs queue as PENDING then fail in the worker
# with "Gotenberg PDF renderer is not configured."
#
# Local dev (API/worker on host, Gotenberg via docker compose):
#   npm run gotenberg:up
#   PRINTABLES_PDF_RENDERER_URL=http://localhost:3010
#
# Docker Compose / Kubernetes (API and worker in the same private network):
#   PRINTABLES_PDF_RENDERER_URL=http://gotenberg:3000
#
# GOTENBERG_URL is accepted as a fallback alias. Do not expose Gotenberg publicly in production.
# Install Arabic-capable fonts in the Gotenberg image/container for correct RTL output.
GOTENBERG_PORT=3010
PRINTABLES_PDF_RENDERER_URL=http://localhost:3010
PRINTABLES_PDF_RENDERER_TIMEOUT_MS=
# Public API origin used in QR verification links, e.g. https://api.qabas.one
PRINTABLES_PUBLIC_BASE_URL=
# Dynamic report/statement print jobs expire after this many days (default 7).
PRINTABLES_REPORT_JOB_TTL_DAYS=
# One-shot worker and cleanup batch sizes for cron/Kubernetes Jobs.
PRINTABLES_WORKER_BATCH_SIZE=
# Daemon poll interval when running `printables:worker` without `--once` (default 10000 ms).
PRINTABLES_WORKER_POLL_INTERVAL_MS=
PRINTABLES_CLEANUP_LIMIT=
PRINTABLES_CLEANUP_DRY_RUN=

# Company identity on official printables (PDF/HTML headers and payload blocks)
COMPANY_NAME=
COMPANY_LEGAL_NAME=
COMPANY_TAX_NUMBER=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_ADDRESS=
COMPANY_LOGO_URL=
# BRAND_LOGO_URL is accepted as a fallback when COMPANY_LOGO_URL is unset

# API docs
# Production: DOCS_ENABLED=false unless Swagger must be public
DOCS_ENABLED=

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# Sentry — leave SENTRY_DSN empty to disable; structured logs + /metrics still work.
# Production:
#   SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
#   SENTRY_ENVIRONMENT=production
#   SENTRY_TRACES_SAMPLE_RATE=0
# Local verification (non-production only): GET /debug-sentry after setting SENTRY_DSN.
# See docs/OBSERVABILITY.md and docs/PRODUCTION_ENV.md
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# 0.0–1.0 performance trace sampling; keep 0 in production unless debugging latency.
SENTRY_TRACES_SAMPLE_RATE=

# ---------------------------------------------------------------------------
# Server speech-to-text (Whisper via Groq or OpenAI)
# ---------------------------------------------------------------------------
# Enable POST /api/v1/speech/transcribe when the frontend speech engine is "server".
#
# Recommended for Egyptian Arabic (fast): Groq whisper-large-v3-turbo
#   SPEECH_SERVER_ENGINE_ENABLED=true
#   SPEECH_PROVIDER=groq
#   SPEECH_API_KEY=<groq-api-key>
#
# OpenAI alternative:
#   SPEECH_PROVIDER=openai
#   SPEECH_API_KEY=<openai-api-key>
#   SPEECH_MODEL=whisper-1
SPEECH_SERVER_ENGINE_ENABLED=
SPEECH_PROVIDER=
SPEECH_API_KEY=
SPEECH_API_BASE_URL=
SPEECH_MODEL=
SPEECH_MAX_FILE_SIZE_MB=
SPEECH_TIMEOUT_MS=
SPEECH_RATE_LIMIT_WINDOW_MS=
SPEECH_RATE_LIMIT_MAX=

# CORS (comma-separated hostnames, without scheme)
# Production example: app.qabas.one,api.qabas.one
CORS_ALLOWED_DOMAINS=

# Rate limiting
API_RATE_LIMIT_WINDOW_MS=
API_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_WINDOW_MS=
AUTH_RATE_LIMIT_MAX=

# Object storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
STORAGE_FORCE_PATH_STYLE=

# ---------------------------------------------------------------------------
# System backups (PostgreSQL + MinIO bundle)
# ---------------------------------------------------------------------------
# Backs up ONE database: the DB name in BACKUP_POSTGRES_URI (or POSTGRES_URI).
# Other databases on the same Postgres instance are not included.
#
# --- API on host, Postgres in Docker (no pg_dump on host) ---
#   PG_DUMP_MODE=docker
#   PG_DOCKER_CONTAINER=infra_postgres
#   POSTGRES_URI=postgresql://qabasone_app:xxx@127.0.0.1:5432/qabasone_db
#   BACKUP_POSTGRES_URI=postgresql://qabas_backup:xxx@127.0.0.1:5432/qabasone_db
#   RESTORE_POSTGRES_URI=postgresql://qabas_restore:xxx@127.0.0.1:5432/qabasone_db
# Host in backup/restore URIs may be 127.0.0.1 or localhost; docker exec rewrites to localhost.
# The API user must be allowed to run: docker exec -i <container> pg_dump|pg_restore ...
#
# --- API in docker-compose.stack.yml (postgresql-client in image) ---
#   PG_DUMP_MODE=local
#   # Docker image ships pg_dump from PGDG; rebuild with PG_CLIENT_MAJOR matching your server major.
#   POSTGRES_URI=postgresql://qabasone-api:password@postgres:5432/qabasone
#   # Optional dedicated roles (connect via service name `postgres`):
#   BACKUP_POSTGRES_URI=postgresql://qabas_backup:xxx@postgres:5432/qabasone
#   RESTORE_POSTGRES_URI=postgresql://qabas_restore:xxx@postgres:5432/qabasone
#
# Local dev default: ./tmp/backups under API repo root
# docker-compose.stack.yml runs a dedicated backups_worker container; set BACKUP_WORKER_ENABLED=false on api there.
# Docker: mount a writable volume at BACKUP_STORAGE_PATH (read-only root cannot create /var/lib/...).
# Recommended in-container path: /app/data/backups
# Example bind mount: /srv/qabasone/backups:/app/data/backups
# Required on the HOST before first start (container cannot chown bind mounts):
#   sudo mkdir -p /srv/qabasone/backups
#   sudo chown -R 1000:1000 /srv/qabasone/backups
BACKUP_STORAGE_PATH=
BACKUP_CRON_ENABLED=
BACKUP_WORKER_ENABLED=
BACKUP_WORKER_LEADER_KEY=
BACKUP_WORKER_LEADER_LEASE_SEC=
BACKUP_WORKER_STALE_RUNNING_SEC=
BACKUP_SCHEDULER_POLL_INTERVAL_MS=
BACKUP_WORKER_POLL_INTERVAL_MS=
BACKUP_MAX_UPLOAD_MB=
# Resumable upload-sessions API: chunk size (default 1 MB for reverse-proxy compatibility).
BACKUP_UPLOAD_CHUNK_MB=
BACKUP_INLINE_MEMORY_MAX_MB=
BACKUP_SINGLE_SHOT_MAX_MB=
BACKUP_UPLOAD_SESSION_TTL_HOURS=
# local = pg_dump on PATH (default; auto-used inside Docker containers).
# docker = host-only: docker exec into PG container (requires Docker CLI on the host).
PG_DUMP_MODE=local
# Docker build only: PostgreSQL client major (pg_dump/pg_restore) — must be >= server major.
PG_CLIENT_MAJOR=17
PG_DOCKER_BIN=docker
PG_DOCKER_CONTAINER=
# Optional URIs with least-privilege backup/restore roles (fall back to POSTGRES_URI).
BACKUP_POSTGRES_URI=
RESTORE_POSTGRES_URI=
# Optional superuser/maintenance URI for CREATE DATABASE + rename swap (needs CREATEDB).
# Defaults to RESTORE_POSTGRES_URI; role must connect to the `postgres` maintenance database.
RESTORE_ADMIN_POSTGRES_URI=
# Safe restore (default): pg_restore into a staging database, verify, then rename-swap.
# Live database is untouched if pg_restore or verification fails.
BACKUP_RESTORE_USE_STAGING_DATABASE=true
# pg_dump live DB to BACKUP_STORAGE_PATH/pre-restore/ before starting restore.
BACKUP_RESTORE_PRE_BACKUP_ENABLED=true
# Keep the pre-restore live database renamed (for rollback) after a successful swap.
BACKUP_RESTORE_KEEP_PRE_RESTORE_DB=true
# Legacy in-place restore only (when BACKUP_RESTORE_USE_STAGING_DATABASE=false):
# DROP SCHEMA public CASCADE before pg_restore.
BACKUP_RESTORE_DROP_PUBLIC_SCHEMA=false
# Terminate other DB sessions before swap / legacy pg_restore --clean.
BACKUP_RESTORE_TERMINATE_CONNECTIONS=true
# pg_restore wall-clock timeout (seconds) and parallel job count.
BACKUP_PG_RESTORE_TIMEOUT_SEC=7200
BACKUP_PG_RESTORE_JOBS=2
# Override pg_dump/pg_restore binaries when PG_DUMP_MODE=local
PG_DUMP_BIN=
PG_RESTORE_BIN=
APP_VERSION=

# Single super-admin seeding (npm run seed:superadmin[:dev]).
# Idempotent: creates or resets ONE super-admin and binds all permissions to its role.
# CLI flags (--username/--password/...) override these env vars.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
SUPERADMIN_DISPLAY_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PHONE=
# Role code to grant; defaults to SUPER_ADMIN.
SUPERADMIN_ROLE_CODE=

# WebAuthn (passkeys)
# WEBAUTHN_RP_NAME: label shown in the browser passkey prompt (e.g. Qabas One)
# WEBAUTHN_RP_ID: registrable domain of the dashboard, without scheme (e.g. app.example.com; use localhost for local dev)
# WEBAUTHN_ORIGIN: primary dashboard origin with scheme (e.g. https://app.example.com)
# WEBAUTHN_ALLOWED_ORIGINS: comma-separated exact origins allowed during verify (must include the dashboard URL)
WEBAUTHN_RP_NAME=
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
WEBAUTHN_ALLOWED_ORIGINS=
