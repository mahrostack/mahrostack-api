// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model AuditLog {
  id String @id @default(uuid())

  // =========================
  // Actor
  // =========================

  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id])

  // =========================
  // Action
  // =========================

  action String

  /**
   * Examples:
   * User
   * Role
   * Party
   * Session
   */
  entityType String

  entityId String?

  metadata Json?

  // =========================
  // Request Info
  // =========================

  /**
   * Request / correlation identifiers for end-to-end tracing.
   * These are optional because audit logs can be created outside HTTP flows.
   */
  requestId     String?
  correlationId String?

  method     String?
  path       String?
  statusCode Int?
  durationMs Int?

  /**
   * Connection lifecycle flags.
   * Useful for detecting client disconnects and partial responses.
   */
  completed Boolean @default(true)
  aborted   Boolean @default(false)

  ipAddress String?
  userAgent String?
  referer   String?

  /**
   * Optional error info for failed requests/actions.
   * Keep messages short and non-sensitive.
   */
  errorCode    String?
  errorMessage String?

  // =========================
  // Audit
  // =========================

  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([requestId])
  @@index([correlationId])
  @@index([method])
  @@index([statusCode])
  @@index([createdAt])
  @@map("audit_logs")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
  DELETED
}

model User {
  id String @id @default(uuid())

  // =========================
  // Identity
  // =========================

  partyId String? @unique
  party   Party?  @relation(fields: [partyId], references: [id])

  // =========================
  // Credentials
  // =========================

  username     String  @unique
  passwordHash String?

  // =========================
  // Verification
  // =========================

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  // =========================
  // Auth State
  // =========================

  status UserStatus @default(INACTIVE)

  lastLoginAt DateTime?

  /**
   * Used for global token invalidation.
   * Incrementing this value invalidates all existing JWTs.
   */
  tokenVersion Int @default(0)

  /**
   * When true, the user must set a new password before accessing protected routes.
   */
  mustChangePassword Boolean @default(false)

  passwordChangedAt DateTime?

  /**
   * Expiry for admin-issued temporary passwords.
   */
  tempPasswordExpiresAt DateTime?

  forceResetAt       DateTime?
  forceResetByUserId String?

  // =========================
  // Security
  // =========================

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // =========================
  // Two Factor Authentication
  // =========================

  twoFactorEnabled            Boolean   @default(false)
  twoFactorSecret             String?
  twoFactorVerifiedAt         DateTime?
  twoFactorRecoveryCodeHashes String[]
  otpFailedAttempts           Int       @default(0)
  otpLockedUntil              DateTime?

  // =========================
  // Avatar
  // =========================

  avatarObjectKey    String?
  avatarOriginalName String?
  avatarMimeType     String?
  avatarSize         Int?
  avatarUploadedAt   DateTime?

  // =========================
  // Audit
  // =========================

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // =========================
  // Relations
  // =========================

  sessions            Session[]
  userRoles           UserRole[]
  webAuthnCredentials WebAuthnCredential[]

  auditLogs                         AuditLog[]
  otpCodes                          OtpCode[]
  journalEntriesCreated             JournalEntry[]            @relation("JournalEntryCreatedBy")
  journalEntriesPosted              JournalEntry[]            @relation("JournalEntryPostedBy")
  journalEntriesVoided              JournalEntry[]            @relation("JournalEntryVoidedBy")
  cashboxesCreated                  Cashbox[]                 @relation("CashboxCreatedBy")
  bankAccountsCreated               BankAccount[]             @relation("BankAccountCreatedBy")
  treasuryReceiptsCreated           TreasuryReceipt[]         @relation("TreasuryReceiptCreatedBy")
  treasuryReceiptsPosted            TreasuryReceipt[]         @relation("TreasuryReceiptPostedBy")
  treasuryReceiptsVoided            TreasuryReceipt[]         @relation("TreasuryReceiptVoidedBy")
  treasuryPaymentsCreated           TreasuryPayment[]         @relation("TreasuryPaymentCreatedBy")
  treasuryPaymentsPosted            TreasuryPayment[]         @relation("TreasuryPaymentPostedBy")
  treasuryPaymentsVoided            TreasuryPayment[]         @relation("TreasuryPaymentVoidedBy")
  treasuryTransfersCreated          TreasuryTransfer[]        @relation("TreasuryTransferCreatedBy")
  treasuryTransfersPosted           TreasuryTransfer[]        @relation("TreasuryTransferPostedBy")
  treasuryTransfersVoided           TreasuryTransfer[]        @relation("TreasuryTransferVoidedBy")
  custodiesCreated                  Custody[]                 @relation("CustodyCreatedBy")
  custodyIssuesCreated              CustodyIssue[]            @relation("CustodyIssueCreatedBy")
  custodyIssuesPosted               CustodyIssue[]            @relation("CustodyIssuePostedBy")
  custodyIssuesVoided               CustodyIssue[]            @relation("CustodyIssueVoidedBy")
  custodyReturnsCreated             CustodyReturn[]           @relation("CustodyReturnCreatedBy")
  custodyReturnsPosted              CustodyReturn[]           @relation("CustodyReturnPostedBy")
  custodyReturnsVoided              CustodyReturn[]           @relation("CustodyReturnVoidedBy")
  custodySettlementsCreated         CustodySettlement[]       @relation("CustodySettlementCreatedBy")
  custodySettlementsPosted          CustodySettlement[]       @relation("CustodySettlementPostedBy")
  custodySettlementsVoided          CustodySettlement[]       @relation("CustodySettlementVoidedBy")
  warehousesResponsible             Warehouse[]               @relation("WarehouseResponsibleUser")
  warehouseAssignments              WarehouseAssignment[]     @relation("WarehouseAssignmentUser")
  stockMovementsCreated             StockMovement[]           @relation("StockMovementCreatedBy")
  openingStocksCreated              OpeningStock[]            @relation("OpeningStockCreatedBy")
  stockTransfersCreated             StockTransfer[]           @relation("StockTransferCreatedBy")
  stockTransfersPosted              StockTransfer[]           @relation("StockTransferPostedBy")
  stockTransfersVoided              StockTransfer[]           @relation("StockTransferVoidedBy")
  stockAdjustmentsCreated           StockAdjustment[]         @relation("StockAdjustmentCreatedBy")
  stockAdjustmentsPosted            StockAdjustment[]         @relation("StockAdjustmentPostedBy")
  stockAdjustmentsVoided            StockAdjustment[]         @relation("StockAdjustmentVoidedBy")
  stockCountsCreated                StockCount[]              @relation("StockCountCreatedBy")
  stockCountsPosted                 StockCount[]              @relation("StockCountPostedBy")
  stockCountsVoided                 StockCount[]              @relation("StockCountVoidedBy")
  purchasesCreated                  Purchase[]                @relation("PurchaseCreatedBy")
  purchasesPosted                   Purchase[]                @relation("PurchasePostedBy")
  purchasesVoided                   Purchase[]                @relation("PurchaseVoidedBy")
  salesCreated                      Sale[]                    @relation("SaleCreatedBy")
  salesPosted                       Sale[]                    @relation("SalePostedBy")
  salesVoided                       Sale[]                    @relation("SaleVoidedBy")
  workDaysAsOwner                   WorkDay[]                 @relation("WorkDayUser")
  workDaysCreated                   WorkDay[]                 @relation("WorkDayCreatedBy")
  workDaysReviewed                  WorkDay[]                 @relation("WorkDayReviewedBy")
  workDaysApproved                  WorkDay[]                 @relation("WorkDayApprovedBy")
  workDaysSupervisorApproved        WorkDay[]                 @relation("WorkDaySupervisorApprovedBy")
  workDaysReviewLocked              WorkDay[]                 @relation("WorkDayReviewLockedBy")
  driverDayOperationsCreated        DriverDayOperation[]      @relation("DriverDayOperationCreatedBy")
  driverDayOperationsUpdated        DriverDayOperation[]      @relation("DriverDayOperationUpdatedBy")
  driverDayPostingJobsRequested     DriverDayPostingJob[]     @relation("DriverDayPostingJobRequestedBy")
  printJobsRequested                PrintJob[]                @relation("PrintJobRequestedBy")
  printableDocumentsCreated         PrintableDocument[]       @relation("PrintableDocumentCreatedBy")
  printableTemplateBundlesCreated   PrintableTemplateBundle[] @relation("PrintableTemplateBundleCreatedBy")
  printableTemplateBundlesUpdated   PrintableTemplateBundle[] @relation("PrintableTemplateBundleUpdatedBy")
  printableTemplateBundlesPublished PrintableTemplateBundle[] @relation("PrintableTemplateBundlePublishedBy")
  driverOperationAuditLogs          DriverOperationAuditLog[]
  documentAttachmentsUploaded       DocumentAttachment[]      @relation("DocumentAttachmentUploadedBy")
  partiesBlocked                    Party[]                   @relation("PartyBlockedBy")
  peerTransfersSent                 DriverPeerTransfer[]      @relation("DriverPeerTransferSenderUser")
  peerTransfersReceived             DriverPeerTransfer[]      @relation("DriverPeerTransferRecipientUser")
  peerTransfersCreated              DriverPeerTransfer[]      @relation("DriverPeerTransferCreatedBy")
  vehicleHandoversSent              VehicleHandover[]         @relation("VehicleHandoverFromDriverUser")
  vehicleHandoversReceived          VehicleHandover[]         @relation("VehicleHandoverToDriverUser")
  vehicleHandoversCreated           VehicleHandover[]         @relation("VehicleHandoverCreatedBy")
  vehicleHandoverReviews            VehicleHandover[]         @relation("VehicleHandoverDiscrepancyReviewedBy")
  vehiclesCreated                   Vehicle[]                 @relation("VehicleCreatedBy")
  manufacturingOrdersCreated        ManufacturingOrder[]      @relation("ManufacturingOrderCreatedBy")
  manufacturingOrdersCompleted      ManufacturingOrder[]      @relation("ManufacturingOrderCompletedBy")
  manufacturingOrdersVoided         ManufacturingOrder[]      @relation("ManufacturingOrderVoidedBy")

  @@index([status])
  @@index([status, createdAt])
  @@map("users")
}

model Session {
  id String @id @default(uuid())

  // =========================
  // Relations
  // =========================

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // =========================
  // Refresh Token
  // =========================

  refreshTokenHash String

  // =========================
  // Device Info
  // =========================

  deviceName String?
  userAgent  String?
  ipAddress  String?

  // =========================
  // Lifecycle
  // =========================

  expiresAt DateTime
  revokedAt DateTime?

  lastUsedAt DateTime?

  // =========================
  // Audit
  // =========================

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id String @id @default(uuid())

  // =========================
  // Identity
  // =========================

  code String @unique
  name String

  desc String?

  // =========================
  // Control
  // =========================

  isSystem Boolean @default(true)
  isActive Boolean @default(true)

  // =========================
  // Audit
  // =========================

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // =========================
  // Relations
  // =========================

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([isActive, createdAt])
  @@map("iam_roles")
}

model Permission {
  id String @id @default(uuid())

  // =========================
  // Identity
  // =========================

  code String @unique

  /**
   * Examples:
   * iam
   * identity
   * inventory
   * accounting
   */
  module String

  description String?

  // =========================
  // Audit
  // =========================

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // =========================
  // Relations
  // =========================

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  id String @id @default(uuid())

  // =========================
  // Relations
  // =========================

  userId String
  user   User   @relation(fields: [userId], references: [id])

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // =========================
  // Audit
  // =========================

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id String @id @default(uuid())

  // =========================
  // Relations
  // =========================

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  // =========================
  // Audit
  // =========================

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model OtpCode {
  id String @id @default(uuid())

  // =========================
  // Relations
  // =========================

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // =========================
  // OTP
  // =========================

  codeHash String

  /**
   * Examples:
   * login
   * reset_password
   * verify_phone
   */
  purpose String

  // =========================
  // Lifecycle
  // =========================

  expiresAt DateTime
  usedAt    DateTime?

  // =========================
  // Audit
  // =========================

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("otp_codes")
}

model WebAuthnCredential {
  id String @id @default(uuid())

  // =========================
  // Relations
  // =========================

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // =========================
  // WebAuthn
  // =========================

  credentialId String @unique

  publicKey Bytes

  counter Int @default(0)

  deviceName String?

  transports String[]

  lastUsedAt DateTime?

  // =========================
  // Audit
  // =========================

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@map("webauthn_credentials")
}

