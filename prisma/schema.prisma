enum SystemBackupStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SystemBackupTrigger {
  MANUAL
  SCHEDULED
}

enum SystemBackupOperationKind {
  VALIDATE
  RESTORE
}

enum SystemBackupOperationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model SystemBackup {
  id              String              @id @default(uuid())
  status          SystemBackupStatus  @default(PENDING)
  trigger         SystemBackupTrigger @default(MANUAL)
  targetsPostgres Boolean             @default(true)
  targetsMinio    Boolean             @default(true)
  sizeBytes       BigInt?
  errorMessage    String?
  manifestVersion String?
  progressPercent Int                 @default(0)
  label           String?
  bundlePath      String?
  createdAt       DateTime            @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  @@index([status, createdAt(sort: Desc)])
  @@map("system_backups")
}

model SystemBackupSettings {
  id        String    @id @default("default")
  enabled   Boolean   @default(false)
  schedule  Json
  retention Json
  targets   Json
  lastRunAt DateTime?
  nextRunAt DateTime?
  updatedAt DateTime  @default(now()) @updatedAt

  @@map("system_backup_settings")
}

model SystemBackupOperation {
  id              String                      @id @default(uuid())
  kind            SystemBackupOperationKind
  status          SystemBackupOperationStatus @default(PENDING)
  stage           String                      @default("queued")
  progressPercent Int                         @default(0)
  messageKey      String?
  bundlePath      String
  workDir         String?
  result          Json?
  errorMessage    String?
  requestedById   String?
  createdAt       DateTime                    @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  @@index([status, createdAt(sort: Desc)])
  @@index([requestedById, createdAt(sort: Desc)])
  @@map("system_backup_operations")
}
