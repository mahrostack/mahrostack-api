model Party {
  id String @id @default(uuid())

  // identity
  displayName String
  legalName   String?
  partyKind   PartyKind @default(PERSON)

  // person name parts - optional because party may be organization
  firstName  String?
  middleName String?
  lastName   String?

  // identifiers
  nationalId String? @unique
  taxNumber  String? @unique

  // contact shortcuts
  email String? @unique
  phone String? @unique

  // notes - temporary simple field
  notes String?

  // control
  status          PartyStatus @default(ACTIVE)
  blockReason     String?
  blockedByUserId String?
  blockedByUser   User?       @relation("PartyBlockedBy", fields: [blockedByUserId], references: [id])
  creditLimit     Decimal?    @db.Decimal(18, 2)
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?

  // audit
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  partyRoles                        PartyRole[]
  user                              User?
  partyAccounts                     PartyAccount[]
  journalEntryLines                 JournalEntryLine[]
  treasuryReceipts                  TreasuryReceipt[]     @relation("TreasuryReceiptParty")
  treasuryPayments                  TreasuryPayment[]     @relation("TreasuryPaymentParty")
  custodies                         Custody[]
  warehousesResponsible             Warehouse[]           @relation("WarehouseResponsibleParty")
  warehouseAssignments              WarehouseAssignment[] @relation("WarehouseAssignmentParty")
  treasuryTransfersSourceParty      TreasuryTransfer[]    @relation("TreasuryTransferSourceParty")
  treasuryTransfersDestinationParty TreasuryTransfer[]    @relation("TreasuryTransferDestinationParty")
  purchasesAsSupplier               Purchase[]            @relation("PurchaseSupplierParty")
  purchasesAsActor                  Purchase[]            @relation("PurchaseActorParty")
  salesAsCustomer                   Sale[]                @relation("SaleCustomerParty")
  salesAsActor                      Sale[]                @relation("SaleActorParty")
  workDays                          WorkDay[]             @relation("WorkDayParty")
  peerTransfersSent                 DriverPeerTransfer[]  @relation("DriverPeerTransferSenderParty")
  peerTransfersReceived             DriverPeerTransfer[]  @relation("DriverPeerTransferRecipientParty")
  vehicleHandoversSent              VehicleHandover[]     @relation("VehicleHandoverFromDriverParty")
  vehicleHandoversReceived          VehicleHandover[]     @relation("VehicleHandoverToDriverParty")
  vehiclesAssigned                  Vehicle[]             @relation("VehicleAssignedDriverParty")

  @@index([displayName])
  @@index([phone])
  @@index([status])
  @@index([isDeleted])
  @@index([isDeleted, createdAt])
  @@map("parties")
}

model PartyRoleDefinition {
  id String @id @default(uuid())

  // examples: CUSTOMER, SUPPLIER, DRIVER, EMPLOYEE
  code String  @unique
  name String
  desc String?

  isSystem Boolean @default(true)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  partyRoles PartyRole[]

  @@index([isActive, createdAt])
  @@map("party_role_definitions")
}

model PartyRole {
  id String @id @default(uuid())

  partyId String
  party   Party  @relation(fields: [partyId], references: [id])

  roleId String
  role   PartyRoleDefinition @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([partyId, roleId])
  @@index([roleId])
  @@map("party_roles")
}

model Account {
  id String @id @default(uuid())

  code       String
  name       String
  type       AccountType
  normalSide AccountNormalSide

  parentId String?
  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[] @relation("AccountHierarchy")

  level    Int
  isLeaf   Boolean @default(true)
  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  partyAccounts                       PartyAccount[]
  journalEntryLines                   JournalEntryLine[]
  cashboxes                           Cashbox[]
  bankAccounts                        BankAccount[]
  treasuryReceiptCounterAccounts      TreasuryReceipt[]        @relation("TreasuryReceiptCounterAccount")
  treasuryPaymentCounterAccounts      TreasuryPayment[]        @relation("TreasuryPaymentCounterAccount")
  treasuryTransferSourceAccounts      TreasuryTransfer[]       @relation("TreasuryTransferSourceAccount")
  treasuryTransferDestinationAccounts TreasuryTransfer[]       @relation("TreasuryTransferDestinationAccount")
  custodies                           Custody[]
  custodySettlementLines              CustodySettlementLine[]
  productInventoryAccounts            Product[]                @relation("ProductInventoryAccount")
  productRevenueAccounts              Product[]                @relation("ProductRevenueAccount")
  productCogsAccounts                 Product[]                @relation("ProductCogsAccount")
  manufacturingOrderExpenseLines      ManufacturingOrderLine[] @relation("ManufacturingOrderLineExpenseAccount")
  purchaseExpenses                    PurchaseExpense[]        @relation("PurchaseExpenseAccount")
  accountBalance                      AccountBalance?

  @@unique([code])
  @@index([parentId])
  @@index([parentId, code])
  @@index([type])
  @@index([isLeaf])
  @@index([isActive])
  @@map("accounts")
}

model AccountBalance {
  accountId String  @id @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  debitTotal  Decimal @default(0) @map("debit_total") @db.Decimal(18, 2)
  creditTotal Decimal @default(0) @map("credit_total") @db.Decimal(18, 2)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("account_balances")
}

model PartyAccount {
  id String @id @default(uuid())

  partyId String
