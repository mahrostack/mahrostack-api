/// Operational workday for any staff role (drivers, keepers, accountants, …).
/// Physical table remains `driver_days` for compatibility.
model WorkDay {
  id String @id @default(uuid())

  dayNo String   @unique
  date  DateTime
  kind  WorkDayKind @default(DRIVER)

  ownerPartyId String @map("driverPartyId")
  ownerParty   Party  @relation("WorkDayParty", fields: [ownerPartyId], references: [id])

  ownerUserId String @map("driverUserId")
  ownerUser   User   @relation("WorkDayUser", fields: [ownerUserId], references: [id])

  warehouseId String?    @map("driverWarehouseId")
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  status DriverDayStatus @default(OPEN)

  openingCustodyBalance Decimal @default(0) @db.Decimal(18, 2)
  expectedCash          Decimal @default(0) @db.Decimal(18, 2)
  actualReturnedCash    Decimal @default(0) @db.Decimal(18, 2)
  shortageAmount        Decimal @default(0) @db.Decimal(18, 2)
  surplusAmount         Decimal @default(0) @db.Decimal(18, 2)

  notes           String?
  vehicleId       String?
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleNotes    String?
  rejectionReason String?

  createdById String
  createdBy   User   @relation("WorkDayCreatedBy", fields: [createdById], references: [id])

  submittedAt  DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("WorkDayReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  approvedById String?
  approvedBy   User?     @relation("WorkDayApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  supervisorApprovedById String?
  supervisorApprovedBy   User?     @relation("WorkDaySupervisorApprovedBy", fields: [supervisorApprovedById], references: [id])
  supervisorApprovedAt   DateTime?

  reviewLockedById String?
  reviewLockedBy   User?     @relation("WorkDayReviewLockedBy", fields: [reviewLockedById], references: [id])
  reviewLockedAt   DateTime?

  shortageDecision DriverDayVarianceDecision?
  surplusDecision  DriverDayVarianceDecision?
  shortageNote     String?
  surplusNote      String?
  voidReason       String?

  varianceJournalEntryId String? @map("variance_journal_entry_id")
  varianceReceiptId      String? @map("variance_receipt_id")

  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  operations            DriverDayOperation[]
  postingJob            DriverDayPostingJob?
  peerTransfersSent     DriverPeerTransfer[] @relation("DriverPeerTransferSenderDay")
  peerTransfersReceived DriverPeerTransfer[] @relation("DriverPeerTransferRecipientDay")
  vehicleHandoversOut   VehicleHandover[]    @relation("VehicleHandoverFromDriverDay")
  vehicleHandoversIn    VehicleHandover[]    @relation("VehicleHandoverToDriverDay")

  @@unique([ownerUserId], map: "driver_days_open_per_driver_unique", where: raw("\"status\" = 'OPEN'"))
  @@unique([ownerUserId, date], map: "driver_days_per_driver_date_unique")
  @@index([date])
  @@index([ownerPartyId])
  @@index([ownerUserId])
  @@index([ownerUserId, status, date])
  @@index([warehouseId])
  @@index([vehicleId])
  @@index([status])
  @@index([kind])
  @@map("driver_days")
}

model Vehicle {
